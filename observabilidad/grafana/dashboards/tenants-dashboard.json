    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 101,
      "title": "Aplicación: Rendimiento, Latencia y Errores (RF-26)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth"
          },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 6 },
      "id": 5,
      "options": { "tooltip": { "mode": "multi" } },
      "title": "Peticiones por Segundo (Throughput)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum by (tenant_id) (rate(http_requests_total{tenant_id=~\"$tenant\", entorno=~\"$entorno\"}[1m]))",
          "legendFormat": "{{tenant_id}} (req/s)",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth"
          },
          "unit": "s"
        }
      },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 6 },
      "id": 6,
      "options": { "tooltip": { "mode": "multi" } },
      "title": "Latencia del Backend (p95 y p99)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le, tenant_id) (rate(http_request_duration_seconds_bucket{tenant_id=~\"$tenant\", entorno=~\"$entorno\"}[2m])))",
          "legendFormat": "{{tenant_id}} - p95",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "histogram_quantile(0.99, sum by (le, tenant_id) (rate(http_request_duration_seconds_bucket{tenant_id=~\"$tenant\", entorno=~\"$entorno\"}[2m])))",
          "legendFormat": "{{tenant_id}} - p99",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 5 }
            ]
          },
          "unit": "percent"
        }
      },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 6 },
      "id": 7,
      "options": { "tooltip": { "mode": "multi" } },
      "title": "Tasa de Errores 5xx (%)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "(sum by (tenant_id) (rate(http_requests_total{status=~\"5..\", tenant_id=~\"$tenant\", entorno=~\"$entorno\"}[2m])) / sum by (tenant_id) (rate(http_requests_total{tenant_id=~\"$tenant\", entorno=~\"$entorno\"}[2m]))) * 100",
          "legendFormat": "{{tenant_id}} - 5xx %",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 },
      "id": 102,
      "title": "Recursos de Servidor EC2: CPU, Memoria, Disco y Red (RF-26)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 80 }
            ]
          },
          "unit": "percent"
        }
      },
      "gridPos": { "h": 7, "w": 6, "x": 0, "y": 14 },
      "id": 8,
      "options": { "tooltip": { "mode": "multi" } },
      "title": "Uso de CPU (%)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "100 - (avg by (tenant_id) (rate(node_cpu_seconds_total{mode=\"idle\", tenant_id=~\"$tenant\", entorno=~\"$entorno\"}[2m])) * 100)",
          "legendFormat": "{{tenant_id}} CPU",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 75 },
              { "color": "red", "value": 90 }
            ]
          },
          "unit": "percent"
        }
      },
      "gridPos": { "h": 7, "w": 6, "x": 6, "y": 14 },
      "id": 9,
      "options": { "tooltip": { "mode": "multi" } },
      "title": "Uso de Memoria RAM (%)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "(1 - (node_memory_MemAvailable_bytes{tenant_id=~\"$tenant\", entorno=~\"$entorno\"} / node_memory_MemTotal_bytes{tenant_id=~\"$tenant\", entorno=~\"$entorno\"})) * 100",
          "legendFormat": "{{tenant_id}} RAM",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 75 },
              { "color": "red", "value": 85 }
            ]
          },
          "unit": "percent"
        }
      },
      "gridPos": { "h": 7, "w": 6, "x": 12, "y": 14 },
      "id": 10,
      "options": { "tooltip": { "mode": "multi" } },
      "title": "Ocupación de Disco (%)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "(1 - (node_filesystem_free_bytes{mountpoint=\"/\", tenant_id=~\"$tenant\", entorno=~\"$entorno\"} / node_filesystem_size_bytes{mountpoint=\"/\", tenant_id=~\"$tenant\", entorno=~\"$entorno\"})) * 100",
          "legendFormat": "{{tenant_id}} Disco",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth"
          },
          "unit": "Bps"
        }
      },
      "gridPos": { "h": 7, "w": 6, "x": 18, "y": 14 },
      "id": 11,
      "options": { "tooltip": { "mode": "multi" } },
      "title": "Tráfico de Red (RX / TX)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum by (tenant_id) (rate(node_network_receive_bytes_total{device!=\"lo\", tenant_id=~\"$tenant\", entorno=~\"$entorno\"}[2m]))",
          "legendFormat": "{{tenant_id}} Entrada (RX)",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum by (tenant_id) (rate(node_network_transmit_bytes_total{device!=\"lo\", tenant_id=~\"$tenant\", entorno=~\"$entorno\"}[2m]))",
          "legendFormat": "{{tenant_id}} Salida (TX)",
          "refId": "B"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 21 },
      "id": 103,
      "title": "Base de Datos MySQL (RF-26)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth"
