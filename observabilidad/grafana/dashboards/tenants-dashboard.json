      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "mysql_global_status_threads_connected{tenant_id=~\"$tenant\", entorno=~\"$entorno\"}",
          "legendFormat": "{{tenant_id}} Threads Conectados",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth"
          },
          "unit": "ops"
        }
      },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 22 },
      "id": 13,
      "options": { "tooltip": { "mode": "multi" } },
      "title": "Queries por Segundo (QPS)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "rate(mysql_global_status_queries{tenant_id=~\"$tenant\", entorno=~\"$entorno\"}[1m])",
          "legendFormat": "{{tenant_id}} QPS",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth"
          },
          "unit": "bytes"
        }
      },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 22 },
      "id": 14,
      "options": { "tooltip": { "mode": "multi" } },
      "title": "Tamaño de Datos InnoDB en Disco",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "mysql_global_status_innodb_page_size{tenant_id=~\"$tenant\", entorno=~\"$entorno\"} * mysql_global_status_buffer_pool_pages_data{tenant_id=~\"$tenant\", entorno=~\"$entorno\"}",
          "legendFormat": "{{tenant_id}} Datos BD",
          "refId": "A"
        }
      ]
    }
