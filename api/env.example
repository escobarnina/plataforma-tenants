DB_HOST=localhost
DB_PORT=5432
DB_NAME=plataforma
DB_USER=plataforma_app
DB_PASSWORD=pon_aqui_tu_clave
ENGINE=fake
PORT=4000

# --- Motor real (ENGINE=tofu) ---
# AMI que construyo Packer (packer/ami-id.ps1). Vacio = Ubuntu estandar con pagina de prueba.
AMI_ID=
# Clave inicial del administrador de cada tenant (8 a 64 caracteres: letras, numeros y . _ @ % + = -).
# Vacio = cada VM genera una y la guarda en /etc/tenant/credenciales.
ADMIN_PASSWORD_INICIAL=
# true = cada tenant arranca con datos de ejemplo (solo para pruebas).
SEED_DATA=false
