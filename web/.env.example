# Copia este archivo como .env para cambiar la configuracion.

# true  = usa la API falsa (src/mock.js), no necesita nada mas.
# false = usa la API real del Integrante 1 en VITE_API_URL.
VITE_USE_MOCK=true
VITE_API_URL=http://localhost:4000

# Dashboard de Grafana para incrustar (observabilidad/ con "docker compose up -d").
VITE_GRAFANA_URL=http://localhost:3000/d/tenants-overview/salud-y-rendimiento-de-tenants?orgId=1&refresh=10s
