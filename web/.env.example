# Copia este archivo como .env para cambiar la configuracion.

# true  = usa la API falsa (src/mock.js), no necesita nada mas.
# false = usa la API real del Integrante 1 en VITE_API_URL.
VITE_USE_MOCK=true
VITE_API_URL=http://localhost:4000

# Dashboard de Grafana para incrustar (lo entrega el Integrante 5).
VITE_GRAFANA_URL=
