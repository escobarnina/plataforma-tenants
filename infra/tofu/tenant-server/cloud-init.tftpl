#!/bin/bash
# Primer arranque de la VM del tenant ${tenant_id}.
# Mientras no exista la AMI de Packer (Integrante 3), deja una pagina de prueba.
# Con la AMI, este script solo escribe la configuracion del tenant.
set -e

mkdir -p /etc/tenant
cat > /etc/tenant/tenant.env <<ENV
TENANT_ID=${tenant_id}
DB_VOLUME_GB=${db_volume_gb}
ENV
chmod 600 /etc/tenant/tenant.env

if ! command -v nginx >/dev/null 2>&1; then
  apt-get update -y
  apt-get install -y nginx
fi
echo "Tenant ${tenant_id} funcionando" > /var/www/html/index.html
systemctl enable --now nginx
